{
  "name": "openlynk",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "pnpm --filter @openlynk/web dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "pnpm --filter @openlynk/db db:generate",
    "db:migrate": "pnpm --filter @openlynk/db db:migrate"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
