# Openlynk Environment Variables Example
# Copy this file to .env.local for local development. Never commit sensitive keys!

# Database connection (PostgreSQL)
# DATABASE_URL: Koneksi pooled (misal PgBouncer / Supavisor / Layerbase pooler) untuk aplikasi runtime.
# Driver postgres-js dikonfigurasi dengan prepare: false agar kompatibel dengan transaction pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openlynk"

# DATABASE_URL_DIRECT: Koneksi langsung (non-pooled / session mode) untuk migrasi DDL schema (drizzle-kit migrate).
# Jika menggunakan layanan cloud pooler, isi dengan connection string langsung (biasanya port 5432 direct).
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/openlynk"

# Better Auth configuration
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-minimum-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 (Opsional: kosongkan jika tidak menggunakan login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application Base URL (digunakan untuk metadataBase, robots.txt, dan sitemap.xml)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Midtrans Payment Gateway Configuration (Snap & Webhooks)
# Dapatkan Server Key & Client Key dari dashboard Midtrans (sandbox: https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Runtime Environment
NODE_ENV="development"
