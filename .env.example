# Openlynk Environment Variables Example
# Copy this file to .env.local for local development. Never commit sensitive keys!

# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openlynk"

# Better Auth configuration
BETTER_AUTH_SECRET="your-super-secret-better-auth-key-minimum-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime Environment
NODE_ENV="development"
